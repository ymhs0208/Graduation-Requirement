# Copy to .env. Do not commit .env.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://gradtrack:change-me@127.0.0.1:5432/gradtrack
PORT=43124
UPLOAD_DIR=./server/var/uploads
APP_ORIGIN=http://127.0.0.1:43123
# Optional for local passkey testing. In production, passkeys use the HTTPS APP_ORIGIN.
# PASSKEY_ORIGIN=http://localhost:43123
COOKIE_SECURE=false
NODE_ENV=development
DEMO_SEED=false

# School mail. Leave SMTP_HOST empty to keep messages in the email log.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=gradtrack@nutc.edu.tw

# Set to a campus CIDR such as 140.128.0.0/16 to limit Nginx. Use all for no limit.
CAMPUS_CIDR=all
ARGON_MEMORY=19456
ARGON_TIME=2
